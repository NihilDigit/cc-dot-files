{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-edit.py",
            "timeout": 20,
            "statusMessage": "检查文件是否受 git 保护"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-shell.py",
            "timeout": 60,
            "statusMessage": "检查删除、全局安装与 git 破坏性操作"
          }
        ]
      }
    ]
  }
}
